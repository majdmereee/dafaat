{
  "name": "daily-cash-pro",
  "version": "1.0.0",
  "description": "تطبيق إدارة الصندوق اليومي",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.restaurant.dailycash",
    "productName": "الصندوق اليومي",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "author": "Majd",
  "license": "MIT",
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "24.9.1"
  }
}
